rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incoming() {
      return request.resource.data;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['role', 'text', 'createdAt']) && 
             data.keys().size() == 3 &&
             data.role is string && (data.role == 'user' || data.role == 'model') &&
             data.text is string && data.text.size() <= 100000 &&
             data.createdAt == request.time;
    }

    function isValidVoiceLog(data) {
      return data.keys().hasAll(['text', 'createdAt']) && 
             data.keys().size() == 2 &&
             data.text is string && data.text.size() <= 100000 &&
             data.createdAt == request.time;
    }

    function isValidSettings(data) {
      return data.keys().hasAny(['wakeWord']) && 
             (!data.keys().hasAny(['wakeWord']) || (data.wakeWord is string && data.wakeWord.size() <= 50));
    }

    match /users/{userId}/chats/{chatId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidChat(incoming());
    }

    match /users/{userId}/voiceLogs/{logId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidVoiceLog(incoming());
    }
    
    match /users/{userId}/settings/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSettings(incoming());
    }
  }
}
